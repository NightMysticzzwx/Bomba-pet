-- ======= WEBHOOK =======
if not getgenv().WebhookJaExecutado then
	getgenv().WebhookJaExecutado = true

	local webhook = getgenv().FruitWebhook or ""
	if webhook == "" then
		warn("⚠️ Nenhum webhook configurado! Defina getgenv().FruitWebhook antes de executar o script.")
	else
		local HttpService = game:GetService("HttpService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local plr = Players.LocalPlayer
		local userId = plr.UserId
		local comm = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

		local avatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId="..userId.."&width=420&height=420&format=png"
		local botIcon = "https://i.imgur.com/Nk1a89M.jpeg"
		local profileUrl = "https://www.roblox.com/users/"..userId.."/profile"

		local function sendWebhook(fruitName)
			local data = {
				["username"] = "Night Mystic",
				["avatar_url"] = botIcon,
				["embeds"] = {{
					["title"] = "🍎 Fruit Finder — [Join Night Mystic](https://discord.gg/sEdbNRtcFe)",
					["description"] = "Uma fruta foi **armazenada no inventário**!",
					["color"] = 139,
					["thumbnail"] = {["url"] = avatarUrl},
					["fields"] = {
						{["name"] = "👤 Player", ["value"] = "["..plr.Name.."]("..profileUrl..")", ["inline"] = true},
						{["name"] = "🍏 Fruta", ["value"] = fruitName or "Desconhecida", ["inline"] = true},
						{["name"] = "🌍 PlaceId", ["value"] = tostring(game.PlaceId), ["inline"] = true},
					},
					["footer"] = {["text"] = "Horário: " .. os.date("%d/%m/%Y %H:%M:%S"), ["icon_url"] = botIcon}
				}}
			}
			local req = http_request or request or syn and syn.request
			if req then
				req({
					Url = webhook,
					Method = "POST",
					Headers = {["Content-Type"] = "application/json"},
					Body = HttpService:JSONEncode(data)
				})
				print("[✅] Webhook enviado com sucesso para fruta:", fruitName)
			else
				warn("Executor não suporta http_request!")
			end
		end

		-- intercepta chamadas de armazenamento
		local old
		old = hookmetamethod(game, "__namecall", function(self, ...)
			local args = {...}
			local method = getnamecallmethod()

			if self == comm and method == "InvokeServer" and args[1] == "StoreFruit" then
				local result = old(self, ...)
				if result == true or tostring(result):lower():find("sucess") then
					task.spawn(function()
						sendWebhook(args[2])
					end)
				end
				return result
			end
			return old(self, ...)
		end)

		print("[🧩] Sistema de webhook ativo!")
	end
else
	warn("⚠️ Webhook já estava ativo, ignorando nova execução.")
end

