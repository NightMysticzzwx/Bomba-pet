local function FruitESP(fruit)
	if fruit:FindFirstChild("Handle") and not fruit:FindFirstChild("FruitESP") then
		local gui = Instance.new("BillboardGui", fruit)
		gui.Name = "FruitESP"
		gui.Size = UDim2.new(0,200,0,50)
		gui.AlwaysOnTop = true
		gui.Adornee = fruit.Handle

		local text = Instance.new("TextLabel", gui)
		text.Size = UDim2.new(1,0,1,0)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.fromRGB(255,255,255)
		text.Font = Enum.Font.GothamBold
		text.TextScaled = true

		task.spawn(function()
			while fruit.Parent == workspace do
				pcall(function()
					local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
					if hrp and fruit:FindFirstChild("Handle") then
						local dist = math.floor((hrp.Position - fruit.Handle.Position).Magnitude)
						text.Text = fruit.Name .. " [" .. dist .. "m]"
					end
				end)
				task.wait(1)
			end
			pcall(function() gui:Destroy() end)
		end)
	end
end

for _, v in pairs(workspace:GetChildren()) do
	if v:IsA("Tool") and v.Name:find("Fruit") then FruitESP(v) end
